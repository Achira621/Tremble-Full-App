{
    "name": "tremble-backend",
    "version": "1.0.0",
    "description": "Backend API for Tremble - Visual-first social photo discovery platform",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "test": "jest --watchAll=false",
        "test:watch": "jest --watch"
    },
    "keywords": [
        "tremble",
        "social",
        "discovery",
        "api"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2",
        "cors": "^2.8.5",
        "bcryptjs": "^2.4.3",
        "jsonwebtoken": "^9.0.2",
        "dotenv": "^16.3.1",
        "express-validator": "^7.0.1",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/cors": "^2.8.17",
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/uuid": "^9.0.7",
        "@types/node": "^20.10.6",
        "typescript": "^5.3.3",
        "ts-node-dev": "^2.0.0",
        "jest": "^29.7.0",
        "@types/jest": "^29.5.11"
    }
}